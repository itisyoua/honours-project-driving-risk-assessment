# CARLA server connection used by web_simulator.py
CARLA_HOST=127.0.0.1
CARLA_PORT=2000

# Browser UI. Keep 0.0.0.0 when accessing from another computer.
WEB_HOST=0.0.0.0
WEB_PORT=8080

# Set this on the Mac to the Ubuntu machine's address, for example:
# CARLA_WEB_URL=http://192.168.1.50:8080
CARLA_WEB_URL=http://127.0.0.1:8080

# Initial scene
CARLA_TOWN=Town03
CARLA_NPC_VEHICLES=20
CARLA_SEED=42

